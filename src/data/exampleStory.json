    {
      "id": "page-woods-18",
      "title": "Victory at Last",
      "atmosphereId": "atmo-main",
      "paragraphs": [
        {
          "id": "pw18-1",
          "text": "<p>The beast dissolves into a cloud of harmless dark smoke. The forest falls quiet once more.</p>"
        },
        {
          "id": "pw18-2",
          "text": "<p>You have survived the night, {{playerName}}. This concludes the Storyworld AI demo!</p>"
        }
      ],
      "choices": []
    },
    {
      "id": "page-woods-19",
      "title": "A Tragic End",
      "atmosphereId": "atmo-cellar",
      "paragraphs": [
        {
          "id": "pw19-1",
          "text": "<p>Your blade fails you. The beast overtakes you in a flurry of shadows.</p>"
        },
        {
          "id": "pw19-2",
          "text": "<p>If only you had found a better weapon to fight the darkness... Restart the demo to try again.</p>"
